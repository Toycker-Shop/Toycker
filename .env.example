# AiSensy WhatsApp OTP
AISENSY_API_KEY=your-aisensy-api-key
AISENSY_CAMPAIGN_NAME=Toycker Whatsapp Login OTP Verification 4 Digit
AISENSY_BASE_URL=https://backend.aisensy.com/campaign/t1/api/v2
AISENSY_SOURCE=new-landing-page form
AISENSY_AUTH_TEMPLATE_EXTRA_PAYLOAD_JSON={"media":{},"buttons":[{"type":"button","sub_type":"url","index":0,"parameters":[{"type":"text","text":"{{OTP_CODE}}"}]}],"carouselCards":[],"location":{},"attributes":{},"paramsFallbackValue":{"FirstName":"user"}}

# Mark360 WhatsApp OTP
MARK360_API_BASE_URL=https://app.mark360.ai/api/v1
MARK360_SEND_MESSAGES_PATH=/send-messages
MARK360_ACCESS_TOKEN=your_mark360_access_token_here
MARK360_AUTH_TEMPLATE_NAME=toycker_login_otp
MARK360_AUTH_TEMPLATE_LANGUAGE=en
MARK360_REQUEST_TIMEOUT_MS=10000

OTP_HASH_SECRET=replace-with-a-long-random-secret
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3
WHATSAPP_LOGIN_EMAIL_DOMAIN=wa.toycker.store

# Trivara Logistics - new dashboard Phase 1
# Keep disabled until Trivara confirms the seller API Key ID, Secret, and pickup address ID.
TRIVARA_ORDER_SYNC_ENABLED=false
TRIVARA_API_BASE_URL=https://api-new.trivaralogistics.com
TRIVARA_API_KEY_ID=your-trivara-api-key-id
TRIVARA_API_SECRET=your-trivara-api-secret
TRIVARA_PICKUP_ADDRESS_ID=your-trivara-pickup-address-id
TRIVARA_CHANNEL_NAME=Toycker
TRIVARA_DEFAULT_WEIGHT_KG=0.5
TRIVARA_DEFAULT_LENGTH_CM=20
TRIVARA_DEFAULT_WIDTH_CM=15
TRIVARA_DEFAULT_HEIGHT_CM=10
TRIVARA_WEBHOOK_AUTH_TOKEN=your-long-random-webhook-token



